#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Tree path must match where dh_dkms installs dkms.conf
DKMS_VERSION := $(shell sed -n 's/^PACKAGE_VERSION="\(.*\)"/\1/p' dkms.conf)
DKMS_DEST = usr/src/ar0234-rpi-dkms-$(DKMS_VERSION)

%:
	dh $@ --with dkms

# DKMS builds on target, so packaging needs no kernel headers
override_dh_auto_build:

# dkms.conf and changelog must name same version, compared in Debian form
override_dh_install:
	@if test "$(subst -,~,$(DKMS_VERSION))" != "$(DEB_VERSION_UPSTREAM)"; then \
		if [ "$${DRIFT_GUARD:-}" = warn ]; then \
			echo "WARNING: dkms.conf PACKAGE_VERSION ($(DKMS_VERSION)) does not map to changelog upstream ($(DEB_VERSION_UPSTREAM)). Mergeable, blocks release until changelog catches up." >&2; \
		else \
			echo "ERROR: dkms.conf PACKAGE_VERSION ($(DKMS_VERSION)) does not map to changelog upstream ($(DEB_VERSION_UPSTREAM)). Open a matching entry with release.sh --prepare, or fix dkms.conf on main." >&2; \
			exit 1; \
		fi; \
	fi
	dh_install ar0234.c ar0234-overlay.dts Makefile dkms.postinst $(DKMS_DEST)
